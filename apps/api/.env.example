# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string (SRV). Atlas clusters are replica sets, so transactions work.
# Replace USER, PASSWORD and CLUSTER. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vrumm

# Comma-separated browser origins allowed to call the API. No wildcard. Production must be https.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Safety switches. They must stay false: the app refuses to start if any is true.
LIVE_RIDES_ENABLED=false
REAL_PAYMENTS_ENABLED=false
REAL_PAYOUTS_ENABLED=false

# Auth tokens.
# ACCESS_TOKEN_SECRET: sign JWT access tokens. Min 32 random chars. Use: openssl rand -hex 32
# REFRESH_TOKEN_SECRET: sign refresh token payload stored inside the opaque DB record.
# Rotate both if compromised. Existing tokens are invalidated automatically on next use.
ACCESS_TOKEN_SECRET=change-me-use-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=change-me-use-openssl-rand-hex-32

# Access token TTL in seconds. Default 900 (15 min). Refresh token TTL in days. Default 30.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cloudinary — document storage (private folder, signed expiring URLs).
# Get these from https://console.cloudinary.com > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name
# How long signed document URLs stay valid, in seconds. Default 300 (5 min).
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300

# Razorpay — test mode only. Used from Phase 7 onwards.
# Get these from https://dashboard.razorpay.com > Settings > API Keys (test mode).
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder