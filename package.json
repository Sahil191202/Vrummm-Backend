{
  "name": "@vrumm/root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint \"apps/**/*.js\" \"packages/**/*.js\" --ignore-pattern \"**/node_modules/**\"",
    "format": "prettier --write \"apps/**/*.js\" \"packages/**/*.js\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
